/*
 * rara_avia keymap — Colemak base with home-row mods, tri-layer and combos,
 * adapted from the reference keymap.
 *
 * Transform / combo position map (see rara_avia.overlay):
 *
 *   0-4   L1..L5    Q  W  F  P  G       5-9   R1..R5    J  L  U  Y  :
 *   10-14 L6..L10   A  R  S  T  D       15-19 R6..R10   H  N  E  I  O
 *   20-24 L11..L15  Z  X  C  V  B       25-29 R11..R15  K  M  ,  .  /
 *   30    ENC1  encoder push (A/B unwired, so &none on every layer)
 *   31-33 L16 L17 L18                   34-36 R16 R17 R18
 *         Outer thumbs L16 (31) and R18 (36) are the two &none slots.
 *
 * vs. the reference: positions 0-29 are identical, and the six reference thumb
 * positions 30-35 land on 31-36 because ENC1 occupies 30. Only combo_dquotes
 * referenced a thumb, so only its second position moved.
 *
 * Dropped from the reference because this board has no such hardware/behaviors:
 * RGB (col 5-9 of SPECIAL), &aim, anti-idle, &inc_dec_kp sensor bindings
 * (encoder A/B not wired yet).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer Definitions

#define COLEMAK 0
#define SYMNUM 1
#define NAV 2
#define SPECIAL 3
#define GAMING 4

/ {
    // --- Combos ---

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        combo_underscore {
            timeout-ms = <35>;
            key-positions = <12 13>;
            bindings = <&kp UNDER>;
        };

        combo_quote {
            timeout-ms = <35>;
            key-positions = <17 18>;
            bindings = <&kp SQT>;
        };

        combo_del {
            timeout-ms = <40>;
            key-positions = <10 11>;
            bindings = <&kp DEL>;
        };

        combo_bslsh {
            timeout-ms = <40>;
            key-positions = <7 8>;
            bindings = <&kp NON_US_BSLH>;
        };

        combo_caps {
            timeout-ms = <40>;
            key-positions = <12 17>;
            bindings = <&caps_word>;
        };

        combo_rbrkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <23 24>;
        };

        combo_lbrkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 22>;
        };

        combo_semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <9 8>;
        };

        combo_rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 4>;
        };

        combo_lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 2>;
        };

        // F + SPACE thumb (position 33 = L18), as in the reference's <2 31>
        combo_dquotes {
            bindings = <&kp AT>;
            key-positions = <2 33>;
        };

        combo_tmux {
            bindings = <&kp LC(B)>;
            key-positions = <13 24>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <2 12>;
        };

        combo_exclm {
            bindings = <&kp EXCLAMATION>;
            key-positions = <3 13>;
        };

        combo_eq {
            bindings = <&kp EQUAL>;
            key-positions = <1 11>;
        };

        combo_lbrc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <20 21>;
        };

        combo_rbrc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <21 22>;
        };
    };

    // --- Conditional Layers (Tri Layer) ---

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <SYMNUM NAV>;
            then-layer = <SPECIAL>;
        };
    };

    // --- Custom Behaviors ---

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    // --- Macros ---

    macros {
        plus_minus: plus_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_1>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };
    };

    // --- Keymap ---

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Colemak Base Layer

        colemak_layer {
            bindings = <
  &kp Q       &kp W       &kp F             &kp P        &kp G      &kp J        &kp L          &kp U        &kp Y       &kp COLON
  &hm LGUI A  &hm LALT R  &hm LSHFT S       &hm LCTRL T  &kp D      &kp H        &hm RCTRL N    &hm RSHFT E  &hm LALT I  &hm RGUI O
  &kp Z       &kp X       &kp C             &kp V        &kp B      &kp K        &kp M          &kp COMMA    &kp DOT     &kp FSLH
  &none  &none  &mt LSHIFT ENTER  &lt SYMNUM SPACE  &kp BACKSPACE  &lt NAV TAB  &none
            >;
        };

        // Layer 1: Symbols & Numbers

        symnum_layer {
            bindings = <
  &kp LA(F4)       &kp AT     &kp DQT    &kp LPAR  &kp RPAR     &none  &kp N7  &kp N8  &kp N9  &kp GRAVE
  &kp NON_US_HASH  &kp EQUAL  &kp MINUS  &kp EXCL  &kp PRCNT    &none  &kp N4  &kp N5  &kp N6  &kp N0
  &plus_minus      &kp LBRC   &kp RBRC   &kp LBKT  &kp RBKT     &none  &kp N1  &kp N2  &kp N3  &kp DOT
  &none  &none  &trans  &trans  &trans  &trans  &none
            >;
        };

        // Layer 2: Navigation & Function Keys

        nav_layer {
            bindings = <
  &kp KP_NUMLOCK  &kp F7  &kp F8  &kp F9  &kp F10    &kp PG_UP  &kp HOME  &kp UP    &kp END    &none
  &kp CAPS        &kp F4  &kp F5  &kp F6  &kp F11    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none
  &kp SCROLLLOCK  &kp F1  &kp F2  &kp F3  &kp F12    &none      &none     &none     &none      &none
  &none  &none  &trans  &trans  &trans  &trans  &none
            >;
        };

        // Layer 3: Special Keys (Activated by SYMNUM + NAV)
        // The reference's RGB block and &aim have no hardware behind them here;
        // those slots are &none. Good candidates if you want them back:
        // &out OUT_USB / &out OUT_BLE / &sys_reset / &bootloader / &studio_unlock

        special_layer {
            bindings = <
  &bt BT_CLR    &bt BT_NXT    &bt BT_PRV    &none         &to GAMING      &none            &none            &none            &none            &none
  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &none            &none            &none            &none            &none
  &none         &none         &none         &none         &none           &none            &none            &none            &none            &none
  &none  &none  &trans  &trans  &trans  &trans  &none
            >;
        };

        // Layer 4: Gaming Layer

        gaming_layer {
            bindings = <
  &kp ENTER  &kp Q  &kp W    &kp E      &kp R    &kp N7  &kp N8  &kp N9   &kp N0    &to COLEMAK
  &kp LSHFT  &kp A  &kp S    &kp D      &kp F    &kp G   &kp J   &kp K    &kp L     &none
  &kp LCTRL  &kp Z  &kp X    &kp C      &kp V    &kp M   &kp I   &kp DOT  &kp LALT  &none
  &none  &none  &kp TAB  &kp SPACE  &none  &none  &none
            >;
        };
    };
};
