// rara_avia default keymap.
//
// Binding order follows default_transform in rara_avia.overlay:
//   row 0: L1..L5            | R1..R5
//   row 1: L6..L10           | R6..R10
//   row 2: L11..L15          | R11..R15
//   row 3: ENC1 L16 L17 L18  | R16 R17 R18
//
// ENC1 (RC(3,1)) is the encoder push switch; it is unbound until the encoder is
// wired up. Encoder A/B are not in the matrix, so there is no sensor node yet.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------
// |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O      |  P       |
// |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L      |  ;       |
// |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  BT_CLR |  BT_SEL0 |
//                    | ESC | SPCE | TAB |               | RAISE | ENTR | BKSP |  DEL |
            bindings = <
&kp Q     &kp W     &kp E     &kp R      &kp T                 &kp Y     &kp U      &kp I      &kp O       &kp P
&kp A     &kp S     &kp D     &kp F      &kp G                 &kp H     &kp J      &kp K      &kp L       &kp SEMI
&kp Z     &kp X     &kp C     &kp V      &kp B                 &kp N     &kp M      &kp COMMA  &bt BT_CLR  &bt BT_SEL 0
&none     &kp ESC   &kp SPACE &kp TAB                          &kp ENTER &kp BKSP   &kp DEL
            >;
        };
    };
};
