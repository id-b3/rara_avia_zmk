/*
 * rara_avia — unibody 4x10 switch matrix on a Seeed XIAO nRF52840 Plus.
 *
 * PCB net -> XIAO pad -> nRF52840 GPIO (per the Seeed Plus pinout):
 *   rows : row0 = D14 = P0.09   row1 = D13 = P1.01
 *          row2 = D12 = P0.19   row3 = D11 = P0.15
 *   cols : col0 = D4  = P0.04   col1 = D15 = P0.10   col2 = D5  = P0.05
 *          col3 = D16 = P0.31   col4 = D6  = P1.11   col5 = D9  = P1.14
 *          col6 = D18 = P1.05   col7 = D8  = P1.13   col8 = D17 = P1.03
 *          col9 = D7  = P1.12
 *
 * D0..D10 go through the board's &xiao_d nexus; D11..D19 exist only on the
 * Plus and have no board definition in ZMK v0.3, so they use raw GPIOs.
 *
 * Diodes are col2row (anode on the column, cathode on the row): columns are
 * driven high, rows are pulled-down inputs.
 *
 * Not in the matrix (from the schematic, unused for now): encoder A = D0,
 * B = D19; CS/MOSI/SCL bus on D1/D2/D3.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "rara_avia-layouts.dtsi"

/*
 * D16 / P0.31 doubles as the battery-voltage divider tap (AIN7) in the XIAO
 * board definition, and COLUMN 3 is wired to D16. Retire the battery sensor so
 * the ADC never reconfigures P0.31 behind the kscan's back — this gives up
 * battery reporting until COLUMN 3 moves to another pad on a future PCB rev.
 */
&vbatt {
    status = "disabled";
};

/ {
    chosen {
        /delete-property/ zmk,battery;
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&xiao_d 4 GPIO_ACTIVE_HIGH>                       /* col0  D4   P0.04 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>                       /* col1  D15  P0.10 */
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>                       /* col2  D5   P0.05 */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>                       /* col3  D16  P0.31 */
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>                       /* col4  D6   P1.11 */
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>                       /* col5  D9   P1.14 */
            , <&gpio1  5 GPIO_ACTIVE_HIGH>                       /* col6  D18  P1.05 */
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>                       /* col7  D8   P1.13 */
            , <&gpio1  3 GPIO_ACTIVE_HIGH>                       /* col8  D17  P1.03 */
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>                       /* col9  D7   P1.12 */
            ;

        row-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* row0  D14  P0.09 */
            , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* row1  D13  P1.01 */
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* row2  D12  P0.19 */
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* row3  D11  P0.15 */
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        /* Keymap order, in physical reading order. Row 3 has no col0/col8/col9. */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                    RC(3,1) RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)
        >;
    };
};
